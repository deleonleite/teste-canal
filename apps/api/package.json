{
  "name": "@ouvion/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand --forceExit",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "ts-node scripts/db-setup.ts",
    "tenant:provision": "ts-node scripts/provision-tenant.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker/worker-main.ts",
    "start:worker": "node dist/worker/worker-main.js",
    "start": "node dist/main.js",
    "e2e:seed": "ts-node scripts/e2e-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@ouvion/contracts": "workspace:*",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "bullmq": "^5",
    "helmet": "^8.0.0",
    "ioredis": "^5",
    "jszip": "^3.10.1",
    "nestjs-cls": "^4.4.1",
    "nestjs-zod": "^3.0.0",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
