# ════════════════════════════════════════════════════════════════════════════════════════════
# OuviON — variáveis de ambiente (API + worker + web). Veja o README.md, seção "Variáveis de ambiente".
#
# ATENÇÃO: a API e o worker NÃO carregam arquivo .env sozinhos: leem só o ambiente do processo
# (exporte no shell ou use um carregador). O CLI do Prisma (migrate/generate) lê apps/api/.env.
# ════════════════════════════════════════════════════════════════════════════════════════════

# ── Banco ────────────────────────────────────────────────────────────────────────────────────
# Runtime da API/worker (papel app_runtime, sujeito a RLS por empresa)
DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/ouvion
# Dono do schema: migrations, provisionamento, seed (NUNCA usado pela aplicação em produção)
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ouvion
# Painel da plataforma (papel platform_admin: sem acesso a conteúdo de denúncia).
# Em dev, se vazio, é derivado do DATABASE_URL trocando o usuário. OBRIGATÓRIA em produção.
PLATFORM_DATABASE_URL=postgresql://platform_admin:platform_admin@localhost:5432/ouvion
# Senhas dos papéis de banco (usadas só pelo `pnpm --filter @ouvion/api db:setup`)
APP_RUNTIME_PASSWORD=app_runtime
PLATFORM_ADMIN_PASSWORD=platform_admin

# ── API ──────────────────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Segredo dos tokens da EQUIPE das empresas. Obrigatório em produção.
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-com-mais-de-32-caracteres
# Segredo dos tokens da PLATAFORMA (separado do anterior). Obrigatório em produção; em dev deriva do JWT_ACCESS_SECRET.
PLATFORM_JWT_SECRET=
# Segredo compartilhado entre o BFF (Next) e a API: prova que a chamada veio do BFF (IP real do cliente).
# O MESMO valor precisa estar no ambiente do web.
BFF_SHARED_SECRET=troque-por-um-segredo-longo-com-mais-de-32-caracteres
# Endereço público do front (usado nos links de convite e do destinatário alternativo por e-mail)
PUBLIC_WEB_URL=http://localhost:3100

# Chave-mestra (32 bytes em base64) da qual derivam as chaves de dados por empresa. Obrigatória em produção.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Rotação da chave-mestra: durante a troca, a antiga entra aqui (separadas por vírgula).
FIELD_ENCRYPTION_KEY_PREVIOUS=

# MFA obrigatório para ADMIN/INVESTIGATOR/AUDITOR. Só dev/staging podem desligar (off); em produção é sempre ligado.
# (O 2º fator da PLATAFORMA é sempre obrigatório: não há opção que o desligue.)
MFA_ENFORCEMENT=on
# Desliga só o limite por IP (útil quando uma suíte de testes dispara tudo do mesmo IP). Nunca em produção.
RATE_LIMIT_DISABLED=false

# ── Anexos (S3-compatível) ───────────────────────────────────────────────────────────────────
# Vazio = memória (só dev/teste; o worker NÃO enxerga a memória da API: para o ciclo enviar→varrer→baixar use MinIO)
S3_BUCKET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# ── Fila / worker (BullMQ) ───────────────────────────────────────────────────────────────────
# Vazio = fila em memória (só dev/teste). O worker exige Redis.
REDIS_URL=redis://localhost:6379
# Antivírus (clamd). Vazio = detector apenas do arquivo de teste EICAR (só dev/teste; produção exige).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Âncora EXTERNA da auditoria ──────────────────────────────────────────────────────────────
# Bucket S3 com Object Lock, em conta separada. Vazio = âncora em MEMÓRIA (só dev/teste).
# ATENÇÃO: se API e worker usarem âncora em memória, a verificação de integridade acusa "âncora não encontrada".
ANCHOR_S3_BUCKET=
ANCHOR_S3_ENDPOINT=
ANCHOR_S3_REGION=
ANCHOR_S3_ACCESS_KEY_ID=
ANCHOR_S3_SECRET_ACCESS_KEY=
ANCHOR_S3_FORCE_PATH_STYLE=false
ANCHOR_RETENTION_DAYS=2555

# ── E-mail transacional (Resend) ─────────────────────────────────────────────────────────────
# Vazio = caixa de saída em memória (só dev/teste; produção exige). Em dev/teste as respostas trazem
# devInviteUrl/devConfirmUrl para você testar os links sem e-mail.
RESEND_API_KEY=
MAIL_FROM=OuviON <nao-responda@ouvion.com>

# ── Web (apps/web, Next.js) ──────────────────────────────────────────────────────────────────
# Onde o BFF encontra a API
API_URL=http://localhost:3001
# (BFF_SHARED_SECRET: o mesmo valor da API, definido acima)
NEXT_TELEMETRY_DISABLED=1
# Só para rodar `next start` em http local com cookies "Secure" desligados (nunca em produção)
# INSECURE_COOKIES=1
