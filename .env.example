# Runtime da API/worker (papel app_runtime, sujeito a RLS)
DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/ouvion
# Migrations e provisionamento (dono do schema)
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ouvion
# Painel SUPER_ADMIN (papel platform_admin, sem acesso a conteúdo)
SUPER_ADMIN_DATABASE_URL=postgresql://platform_admin:platform_admin@localhost:5432/ouvion
PORT=3001

# Chave-mestra (32 bytes em base64) da qual derivam as chaves de dados por tenant. Obrigatória em produção.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
PUBLIC_WEB_URL=http://localhost:3000

# Storage de anexos (S3-compatível). Vazio = memória (só dev/teste). MinIO local do docker-compose:
S3_BUCKET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# MFA obrigatório para ADMIN/INVESTIGATOR/AUDITOR. Só dev/staging podem desligar (off); em produção é sempre ligado.
MFA_ENFORCEMENT=on

# Fila/worker (BullMQ). Vazio = fila em memória (só dev/teste). O worker exige Redis: `pnpm --filter @ouvion/api worker`
REDIS_URL=redis://localhost:6379
# Antivírus (clamd auto-hospedado). Vazio = detector apenas do arquivo de teste EICAR (só dev/teste; produção exige).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Rotação da chave-mestra: durante a troca, a antiga entra aqui (separadas por vírgula) até reembrulhar as chaves de dados.
FIELD_ENCRYPTION_KEY_PREVIOUS=

# Âncora EXTERNA da auditoria: bucket S3 com Object Lock em conta de nuvem SEPARADA, com credenciais próprias.
# Vazio = âncora em memória (só dev/teste; produção exige).
ANCHOR_S3_BUCKET=
ANCHOR_S3_ENDPOINT=
ANCHOR_S3_REGION=
ANCHOR_S3_ACCESS_KEY_ID=
ANCHOR_S3_SECRET_ACCESS_KEY=
ANCHOR_S3_FORCE_PATH_STYLE=false
ANCHOR_RETENTION_DAYS=2555

# E-mail transacional (Resend). Vazio = caixa de saída em memória (só dev/teste; produção exige).
RESEND_API_KEY=
MAIL_FROM=OuviON <nao-responda@ouvion.com>
